pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland
import qs.config
import "../config/Palette.js" as Palette

// Pushes the current palette / shape to the rest of the system:
//   - Hyprland borders + window rounding (hyprctl eval, nothing written to your config)
//   - Alacritty colours (~/.cache/qshell/alacritty.toml, imported by alacritty.toml)
//   - ~/.cache/qshell/colors.json for anything else you want to script
//   - GTK3: generated theme qshell-a/b in ~/.local/share/themes, swapped via gsettings so running apps recolour live;
//     GTK4: ~/.config/gtk-4.0/gtk.css (read at app start). Both only when option gtkTint is on
Singleton {
	id: root

	readonly property string cacheDir: Settings.home + "/.cache/qshell"
	property bool started: false

	function start() { started = true; debounce.restart(); }

	function hyprColor(hex, a) { return "rgba(" + String(hex).replace("#", "") + a + ")"; }

	function rgba(hex, a) {
		var h = String(hex).replace("#", "");
		return "rgba(" + parseInt(h.substr(0, 2), 16) + ", " + parseInt(h.substr(2, 2), 16) + ", " + parseInt(h.substr(4, 2), 16) + ", " + a + ")";
	}

	function gtkCss(p) {
		var d = [
			["accent_color", p.primary], ["accent_bg_color", p.primary], ["accent_fg_color", p.onPrimary],
			["window_bg_color", p.bg], ["window_fg_color", p.fg],
			["view_bg_color", p.surface], ["view_fg_color", p.fg],
			["headerbar_bg_color", p.surface], ["headerbar_fg_color", p.fg], ["headerbar_backdrop_color", p.bg],
			["headerbar_border_color", p.outlineDim], ["headerbar_shade_color", rgba(p.bg, 0.36)],
			["sidebar_bg_color", p.surface], ["sidebar_fg_color", p.fg], ["sidebar_backdrop_color", p.bg], ["sidebar_border_color", p.outlineDim],
			["card_bg_color", p.surfaceHi], ["card_fg_color", p.fg], ["card_shade_color", rgba(p.bg, 0.36)],
			["dialog_bg_color", p.surfaceHi], ["dialog_fg_color", p.fg],
			["popover_bg_color", p.surfaceTop], ["popover_fg_color", p.fg],
			["thumbnail_bg_color", p.surfaceHi], ["thumbnail_fg_color", p.fg],
			["destructive_color", p.error], ["destructive_bg_color", p.error], ["destructive_fg_color", p.onPrimary],
			["success_color", p.ok], ["success_bg_color", p.ok], ["success_fg_color", p.bg],
			["warning_color", p.warn], ["warning_bg_color", p.warn], ["warning_fg_color", p.bg],
			["error_color", p.error], ["error_bg_color", p.error], ["error_fg_color", p.bg],
			["borders", p.outlineDim], ["shade_color", rgba(p.bg, 0.36)], ["scrollbar_outline_color", p.outlineDim]
		];
		var css = "/* generated by quickshell SystemTheme \u2014 edits are overwritten */\n";
		for (var i = 0; i < d.length; i++) css += "@define-color " + d[i][0] + " " + d[i][1] + ";\n";
		return css;
	}

	function apply() {
		if (!started || !Settings.ready) return;
		var p = Theme.pal;

		if (Settings.opt("applyHyprland", true)) {
			var lua = "hl.config({ general = { border_size = " + Settings.opt("hyprBorder", 2)
				+ ", col = { active_border = { colors = { \"" + hyprColor(p.primary, "ff") + "\", \"" + hyprColor(p.tertiary, "ff")
				+ "\" }, angle = 45 }, inactive_border = \"" + hyprColor(p.outlineDim, "cc") + "\" } }, decoration = { rounding = "
				+ Theme.rounding + " } })";
			hypr.command = ["hyprctl", "eval", lua];
			hypr.running = true;
		}

		if (Settings.previewing) return;   // preview: Hyprland only

		var a = Palette.ansi(p, Theme.mono);
		var names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"];
		var toml = "# Generated by the shell - do not edit.\n[colors.primary]\nbackground = \"" + p.bg + "\"\nforeground = \"" + p.fg
			+ "\"\n\n[colors.cursor]\ntext = \"" + p.bg + "\"\ncursor = \"" + p.primary
			+ "\"\n\n[colors.selection]\ntext = \"" + p.fg + "\"\nbackground = \"" + p.primaryDim + "\"\n\n[colors.normal]\n";
		for (var i = 0; i < 8; i++) toml += names[i] + " = \"" + a.normal[i] + "\"\n";
		toml += "\n[colors.bright]\n";
		for (var j = 0; j < 8; j++) toml += names[j] + " = \"" + a.bright[j] + "\"\n";

		var json = JSON.stringify({ theme: Settings.themeName, wallpaper: Wallpapers.current, palette: p, ansi: a }, null, "\t");
		var gtk = Settings.opt("gtkTint", true);
		var key = json + toml + gtkCss(p) + gtk + Settings.opt("applyAlacritty", true);
		if (key === lastKey) return;   // nothing changed (e.g. a preview was reverted): leave the files alone
		lastKey = key;
		var dark0 = p.mode !== "light";
		var base = dark0 ? "adw-gtk3-dark" : "adw-gtk3";
		var stub = "/* generated by quickshell SystemTheme — colours live in ~/.local/share/themes/qshell-* */";
		// GTK3: write the CSS into the A/B theme slot that is NOT current, then switch gtk-theme to it
		// (GTK3 only reloads live when the theme name changes). gtkTint off: back to plain adw-gtk3.
		var gtkScript = "if [ \"$6\" = 1 ]; then"
			+ " d=\"$7/gtk-4.0\"; mkdir -p \"$d\" && printf '%s' \"$5\" > \"$d/gtk.css.tmp\" && mv \"$d/gtk.css.tmp\" \"$d/gtk.css\";"
			+ " d=\"$7/gtk-3.0\"; mkdir -p \"$d\" && printf '%s\\n' \"${10}\" > \"$d/gtk.css.tmp\" && mv \"$d/gtk.css.tmp\" \"$d/gtk.css\";"
			+ " cur=$(gsettings get org.gnome.desktop.interface gtk-theme); if [ \"$cur\" = \"'qshell-a'\" ]; then s=b; else s=a; fi;"
			+ " t=\"$9/qshell-$s\"; mkdir -p \"$t/gtk-3.0\" &&"
			+ " printf '[Desktop Entry]\\nType=X-GNOME-Metatheme\\nName=qshell-%s\\n\\n[X-GNOME-Metatheme]\\nGtkTheme=qshell-%s\\n' \"$s\" \"$s\" > \"$t/index.theme.tmp\" && mv \"$t/index.theme.tmp\" \"$t/index.theme\" &&"
			+ " printf '@import url(\"file:///usr/share/themes/%s/gtk-3.0/gtk.css\");\\n%s' \"$8\" \"$5\" > \"$t/gtk-3.0/gtk.css.tmp\" && mv \"$t/gtk-3.0/gtk.css.tmp\" \"$t/gtk-3.0/gtk.css\" &&"
			+ " gsettings set org.gnome.desktop.interface gtk-theme \"qshell-$s\";"
			+ " [ -f \"$7/gtk-3.0/settings.ini\" ] && sed -i \"s/^gtk-theme-name=.*/gtk-theme-name=qshell-$s/\" \"$7/gtk-3.0/settings.ini\";"
			+ " else gsettings set org.gnome.desktop.interface gtk-theme \"$8\";"
			+ " [ -f \"$7/gtk-3.0/settings.ini\" ] && sed -i \"s/^gtk-theme-name=.*/gtk-theme-name=$8/\" \"$7/gtk-3.0/settings.ini\"; fi";
		writer.command = ["sh", "-c",
			"mkdir -p \"$1\" && printf '%s\\n' \"$2\" > \"$1/colors.json\" && if [ \"$4\" = 1 ]; then printf '%s' \"$3\" > \"$1/alacritty.toml.tmp\" && mv \"$1/alacritty.toml.tmp\" \"$1/alacritty.toml\"; fi; "
			+ gtkScript,
			"sh", root.cacheDir, json, toml, Settings.opt("applyAlacritty", true) ? "1" : "0",
			gtk ? gtkCss(p) : "", gtk ? "1" : "0", Settings.home + "/.config", base, Settings.home + "/.local/share/themes", stub];
		writer.running = true;

		if (gtk && p.mode !== lastMode) {
			lastMode = p.mode;
			var dark = p.mode !== "light";
			scheme.command = ["sh", "-c",
				"gsettings set org.gnome.desktop.interface color-scheme \"$1\"",
				"sh", dark ? "prefer-dark" : "prefer-light"];
			scheme.running = true;
		}
	}

	Timer { id: debounce; interval: 350; onTriggered: root.apply() }

	Connections {
		target: Theme
		function onPalChanged() { debounce.restart(); }
		function onRoundingChanged() { debounce.restart(); }
	}
	Connections {
		target: Settings
		function onGlobalChanged() { debounce.restart(); }
		function onPreviewingChanged() { debounce.restart(); }
	}
	// Hyprland forgets runtime values when its config reloads - push them again.
	Connections {
		target: Hyprland
		function onRawEvent(event) { if (event.name === "configreloaded") debounce.restart(); }
	}

	property string lastKey: ""
	property string lastMode: ""
	Process { id: scheme }
	Process { id: hypr }
	Process { id: writer }
}
